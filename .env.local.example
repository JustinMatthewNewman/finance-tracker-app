# Copy to .env.local and fill in with values from YOUR OWN Firebase project.
# Nothing here is shared with any other app — create a separate Firebase
# project and a separate Cloud SQL instance for this one.

# --- Firebase web app (client-side; safe to expose) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin service account (server-side; SECRET) ---
# Private key must keep its literal \n escapes when pasted on one line.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Local emulators (LOCAL ONLY — never set these in a deployed env) ---
#
# FIREBASE_AUTH_EMULATOR_HOST switches firebase-admin to accepting ONLY
# unsigned tokens. In production that rejects real sign-ins and accepts forged
# ones, so lib/emulatorGuard.ts refuses to start if it is set there.
# Set to "true" to point Auth + Data Connect at the local emulators
# (ports 9199 / 9499 — deliberately different from the time tracker's
# 9099 / 9399 so both apps can run at the same time).
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
