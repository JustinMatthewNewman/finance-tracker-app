# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Firebase Data Connect emulator state/logs
/dataconnect/.dataconnect/pgliteData
/dataconnect-debug.log
/firebase-debug.log
/pglite-debug.log
!.env.local.example

# Real bank statement exports. transaction_data/ is where you drop your own
# Wells Fargo CSVs to try the importer against; it is nobody else's business
# and it never goes in the repo. The committed fake equivalents live in
# transaction_data.example/ and are what lib/wellsFargoCsv.test.ts reads.
/transaction_data/
